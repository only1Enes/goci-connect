# Copy this file to .env and replace the empty credential values.
# Never commit the populated .env file.

# Configure GitHub, Google, or both. Remove an unused provider block or leave
# all three values empty.
# Local callback: http://127.0.0.1:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# Local callback: http://127.0.0.1:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Optional server settings.
GOCI_CONNECT_ADDR=127.0.0.1:8080
GOCI_CONNECT_SECURE_COOKIE=false
GOCI_CONNECT_TLS_CERT_FILE=
GOCI_CONNECT_TLS_KEY_FILE=
